# =============================================================================
# JeanClaude Environment Configuration
# Copy to .env and fill in your values.
# =============================================================================

# ---------------------------------------------------------------------------
# Required
# ---------------------------------------------------------------------------

# DeepSeek API key (required for Claude Code -> DeepSeek bridge)
DEEPSEEK_API_KEY=sk-your-deepseek-key

# Open Responses sidecar API key (formerly RESPONSE_API_KEY, which is deprecated)
JEANCLAUDE_OPEN_RESPONSES_API_KEY=jrsp-local-dev-key-change-me

# ---------------------------------------------------------------------------
# Privacy Lockdown (ENABLED BY DEFAULT)
# ---------------------------------------------------------------------------

# Master privacy switch. When enabled (default), JeanClaude:
#   - Routes ALL model traffic to DeepSeek (never Anthropic)
#   - Disables Claude Code telemetry, diagnostics, feedback, surveys
#   - Disables auto-updates, marketplace auto-install, feature flags
#   - Disables prompt history, session persistence, personalization/memory
#   - Strips all Anthropic API keys, OAuth tokens, and session variables
#   - Uses ephemeral home directories (no persistent Claude state)
#   - Sets all OTEL exporters to "none"
#   - Disables Claude.ai MCP servers
# To disable privacy lockdown (NOT RECOMMENDED):
#   JEANCLAUDE_PRIVACY_LOCKDOWN=0
#   JEANCLAUDE_INSECURE_DISABLE_PRIVACY_LOCKDOWN=1
JEANCLAUDE_PRIVACY_LOCKDOWN=1

# Ephemeral home: use a temp directory for each run (on by default in lockdown)
JEANCLAUDE_EPHEMERAL_HOME=1

# Disable JeanClaude auto-updates
JEANCLAUDE_DISABLE_UPDATES=1

# Block all Anthropic egress (defense-in-depth)
JEANCLAUDE_DISABLE_ANTHROPIC_EGRESS=1

# Disable gateway log file (only operational errors to tmpfs)
JEANCLAUDE_DISABLE_GATEWAY_LOG_FILE=1

# Gateway log level: error (minimal) in privacy lockdown
JEANCLAUDE_GATEWAY_LOG_LEVEL=error

# ---------------------------------------------------------------------------
# Model Profile
# ---------------------------------------------------------------------------

# JeanClaude model profile (REQUIRED: v4-flash, v4-flash-thinking, v4-pro, v4-pro-thinking)
#   v4-flash          — fast model, no extended thinking
#   v4-flash-thinking — fast model with extended thinking enabled
#   v4-pro            — high-capability model, no extended thinking
#   v4-pro-thinking   — high-capability model with extended thinking enabled
JEANCLAUDE_MODEL_PROFILE=v4-pro-thinking

# ---------------------------------------------------------------------------
# Execution Mode
# ---------------------------------------------------------------------------

# Execution mode: direct (default), gateway, auto
#   direct  — model provider directly
#   gateway — route through the JeanClaude Gateway
#   auto    — auto-detect best mode
JEANCLAUDE_MODE=direct

# ---------------------------------------------------------------------------
# Gateway Configuration (only used when JEANCLAUDE_MODE=gateway)
# ---------------------------------------------------------------------------

# Gateway operating mode: auto, process, docker
JEANCLAUDE_GATEWAY_MODE=auto

# Gateway host to bind/connect to
JEANCLAUDE_GATEWAY_HOST=127.0.0.1

# Gateway port (auto = find available port)
JEANCLAUDE_GATEWAY_PORT=auto

# Explicit gateway URL (overrides host/port when set)
JEANCLAUDE_GATEWAY_URL=

# Keep gateway alive across sessions (0 = stop after last session, 1 = keep alive)
JEANCLAUDE_GATEWAY_KEEPALIVE=0

# ---------------------------------------------------------------------------
# Anthropic-Compatible Base URL
# ---------------------------------------------------------------------------

# Anthropic-compatible base URL for the model provider
# DEFAULT: https://api.deepseek.com/anthropic
# WARNING: Do NOT set this to api.anthropic.com or claude.ai — JeanClaude
# will abort in privacy lockdown if it detects Anthropic URLs.
JEANCLAUDE_ANTHROPIC_BASE_URL=https://api.deepseek.com/anthropic

# ---------------------------------------------------------------------------
# Claude Code Version (PINNED — never "latest")
# ---------------------------------------------------------------------------

# Claude Code npm version to install. MUST be an exact version, not "latest".
# JeanClaude privacy lockdown rejects "latest" as unsafe.
CLAUDE_CODE_NPM_VERSION=1.0.58

# ---------------------------------------------------------------------------
# Open Responses Sidecar (disabled by default in privacy lockdown)
# ---------------------------------------------------------------------------

JEANCLAUDE_OPEN_RESPONSES_URL=http://open-responses:8080
JEANCLAUDE_OPEN_RESPONSES_PUBLIC_URL=http://127.0.0.1:8080
OPEN_RESPONSES_IMAGE=
OPEN_RESPONSES_TAG=0.5.3

# Optional provider/env compatibility for Open Responses
OPENAI_API_KEY=
# ANTHROPIC_API_KEY is intentionally absent — do not set in privacy lockdown
OPENROUTER_API_KEY=
EMBEDDING_MODEL_ID=openai/text-embedding-3-large
MEMORY_STORE_PASSWORD=obviously_not_a_safe_password

# ---------------------------------------------------------------------------
# Web Search (via Open Responses / MCP)
# ---------------------------------------------------------------------------

JEANCLAUDE_WEB_SEARCH=off
BRAVE_API_KEY=

# ---------------------------------------------------------------------------
# Documents (via Open Responses / Unstructured / MCP)
# ---------------------------------------------------------------------------

# Disabled by default in privacy lockdown
JEANCLAUDE_DOCUMENTS=off
JEANCLAUDE_DOCUMENT_STORE_EPHEMERAL=1
UNSTRUCTURED_API_KEY=
UNSTRUCTURED_API_URL=https://api.unstructuredapp.io/general/v0/general

# ---------------------------------------------------------------------------
# MCP (Model Context Protocol)
# ---------------------------------------------------------------------------

# Enable the JeanClaude MCP server (jeanclaude-tools)
JEANCLAUDE_ENABLE_MCP=1

# ---------------------------------------------------------------------------
# Build & Runtime
# ---------------------------------------------------------------------------

# Override path to the claude binary (default: auto-detected)
# JEANCLAUDE_CLAUDE_BIN=/usr/local/bin/claude

# Skip .env file loading at startup (set to 1 to disable)
# JEANCLAUDE_NO_DOTENV=0

# ---------------------------------------------------------------------------
# Debug & Logging
# ---------------------------------------------------------------------------

# Log level: error (minimal in privacy lockdown), warn, info, debug
# Default: error in privacy lockdown
JEANCLAUDE_LOG_LEVEL=error

# Dump raw response bodies for debugging (0 or 1)
JEANCLAUDE_DEBUG_BODY=0

# Suppress non-critical warnings (set to 1 to quiet)
# JEANCLAUDE_QUIET=0

# Enable debug-level output in the entrypoint script (set to 1)
# JEANCLAUDE_DEBUG=0

# ---------------------------------------------------------------------------
# Host UID/GID passthrough for bind mounts (optional)
# ---------------------------------------------------------------------------

HOST_UID=1000
HOST_GID=1000

# ---------------------------------------------------------------------------
# Deprecated Aliases (still read but emit warnings)
# ---------------------------------------------------------------------------

# Deprecated: use JEANCLAUDE_MODEL_PROFILE instead
# JEANCLAUDE_MODEL=deepseek-v4-pro

# Deprecated: use JEANCLAUDE_GATEWAY_MODE instead
# JEANCLAUDE_BRIDGE_MODE=process

# Deprecated: use JEANCLAUDE_OPEN_RESPONSES_API_KEY instead
# RESPONSE_API_KEY=jrsp-local-dev-key-change-me
