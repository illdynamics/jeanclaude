#!/usr/bin/env bash
set -Eeuo pipefail

log() {
  printf '[jeanclaude] %s\n' "$*" >&2
}

warn() {
  if [[ "${JEANCLAUDE_QUIET:-}" != "1" ]]; then
    printf '[jeanclaude:warn] %s\n' "$*" >&2
  fi
}

die() {
  printf '[jeanclaude:error] %s\n' "$*" >&2
  exit 1
}

# ── Deprecated env var migrations ────────────────────────────────────
if [[ -n "${JEANCLAUDE_BRIDGE_MODE:-}" ]]; then
  if [[ -z "${JEANCLAUDE_GATEWAY_MODE:-}" ]]; then
    export JEANCLAUDE_GATEWAY_MODE="$JEANCLAUDE_BRIDGE_MODE"
  fi
  warn "JEANCLAUDE_BRIDGE_MODE is deprecated; use JEANCLAUDE_GATEWAY_MODE instead"
fi

if [[ -z "${JEANCLAUDE_OPEN_RESPONSES_API_KEY:-}" && -n "${RESPONSE_API_KEY:-}" ]]; then
  export JEANCLAUDE_OPEN_RESPONSES_API_KEY="$RESPONSE_API_KEY"
  warn "RESPONSE_API_KEY is deprecated; use JEANCLAUDE_OPEN_RESPONSES_API_KEY instead"
fi

# ── Privacy lockdown defaults ───────────────────────────────────────
: "${JEANCLAUDE_PRIVACY_LOCKDOWN:=1}"
: "${JEANCLAUDE_EPHEMERAL_HOME:=1}"
: "${JEANCLAUDE_DISABLE_UPDATES:=1}"
: "${JEANCLAUDE_DISABLE_ANTHROPIC_EGRESS:=1}"
: "${JEANCLAUDE_DISABLE_GATEWAY_LOG_FILE:=1}"
: "${JEANCLAUDE_GATEWAY_LOG_LEVEL:=error}"
: "${JEANCLAUDE_DOCUMENTS:=off}"
: "${JEANCLAUDE_DOCUMENT_STORE_EPHEMERAL:=1}"

is_truthy() {
  case "$(printf '%s' "${1:-}" | tr '[:upper:]' '[:lower:]')" in
    1|true|yes|on) return 0 ;;
    *) return 1 ;;
  esac
}

# ── Strip parent Anthropic auth ─────────────────────────────────────
if is_truthy "${JEANCLAUDE_PRIVACY_LOCKDOWN:-1}"; then
  unset ANTHROPIC_API_KEY ANTHROPIC_AUTH_TOKEN 2>/dev/null || true
  unset CLAUDE_ACCESS_TOKEN CLAUDE_REFRESH_TOKEN CLAUDE_ORG_ID CLAUDE_SESSION_ID 2>/dev/null || true
  unset CLAUDE_CODE_OAUTH_TOKEN CLAUDE_CODE_OAUTH_REFRESH_TOKEN CLAUDE_CODE_OAUTH_SCOPES 2>/dev/null || true
fi

# ── Force privacy env vars into child process ───────────────────────
# These are set as defaults; explicit user overrides still work unless
# JEANCLAUDE_PRIVACY_LOCKDOWN=1 (which defaults to on).
if is_truthy "${JEANCLAUDE_PRIVACY_LOCKDOWN:-1}"; then
  export CLAUDE_CODE_DISABLE_NONESSENTIAL_TRAFFIC="${CLAUDE_CODE_DISABLE_NONESSENTIAL_TRAFFIC:-1}"
  export CLAUDE_CODE_DISABLE_OFFICIAL_MARKETPLACE_AUTOINSTALL="${CLAUDE_CODE_DISABLE_OFFICIAL_MARKETPLACE_AUTOINSTALL:-1}"
  export CLAUDE_CODE_DISABLE_FEEDBACK_SURVEY="${CLAUDE_CODE_DISABLE_FEEDBACK_SURVEY:-1}"
  export CLAUDE_CODE_DISABLE_AUTO_MEMORY="${CLAUDE_CODE_DISABLE_AUTO_MEMORY:-1}"
  export CLAUDE_CODE_SKIP_PROMPT_HISTORY="${CLAUDE_CODE_SKIP_PROMPT_HISTORY:-1}"
  export CLAUDE_CODE_DISABLE_CLAUDE_MDS="${CLAUDE_CODE_DISABLE_CLAUDE_MDS:-1}"
  export CLAUDE_CODE_DISABLE_POLICY_SKILLS="${CLAUDE_CODE_DISABLE_POLICY_SKILLS:-1}"
  export CLAUDE_CODE_DISABLE_GIT_INSTRUCTIONS="${CLAUDE_CODE_DISABLE_GIT_INSTRUCTIONS:-1}"
  export CLAUDE_CODE_DISABLE_EXPERIMENTAL_BETAS="${CLAUDE_CODE_DISABLE_EXPERIMENTAL_BETAS:-1}"
  export CLAUDE_CODE_DISABLE_TERMINAL_TITLE="${CLAUDE_CODE_DISABLE_TERMINAL_TITLE:-1}"
  export CLAUDE_CODE_DISABLE_AGENT_VIEW="${CLAUDE_CODE_DISABLE_AGENT_VIEW:-1}"
  export CLAUDE_CODE_DISABLE_BACKGROUND_TASKS="${CLAUDE_CODE_DISABLE_BACKGROUND_TASKS:-1}"
  export CLAUDE_CODE_DISABLE_CRON="${CLAUDE_CODE_DISABLE_CRON:-1}"
  export CLAUDE_CODE_ENABLE_AWAY_SUMMARY="${CLAUDE_CODE_ENABLE_AWAY_SUMMARY:-0}"
  export CLAUDE_CODE_ENABLE_PROMPT_SUGGESTION="${CLAUDE_CODE_ENABLE_PROMPT_SUGGESTION:-false}"
  export CLAUDE_CODE_ENABLE_TELEMETRY="${CLAUDE_CODE_ENABLE_TELEMETRY:-0}"
  export CLAUDE_CODE_ENABLE_GATEWAY_MODEL_DISCOVERY="${CLAUDE_CODE_ENABLE_GATEWAY_MODEL_DISCOVERY:-0}"
  export CLAUDE_CODE_IDE_SKIP_AUTO_INSTALL="${CLAUDE_CODE_IDE_SKIP_AUTO_INSTALL:-1}"
  export CLAUDE_CODE_AUTO_CONNECT_IDE="${CLAUDE_CODE_AUTO_CONNECT_IDE:-false}"
  export CLAUDE_CODE_MCP_ALLOWLIST_ENV="${CLAUDE_CODE_MCP_ALLOWLIST_ENV:-1}"
  export CLAUDE_CODE_SUBPROCESS_ENV_SCRUB="${CLAUDE_CODE_SUBPROCESS_ENV_SCRUB:-1}"
  export DISABLE_TELEMETRY="${DISABLE_TELEMETRY:-1}"
  export DO_NOT_TRACK="${DO_NOT_TRACK:-1}"
  export DISABLE_ERROR_REPORTING="${DISABLE_ERROR_REPORTING:-1}"
  export DISABLE_FEEDBACK_COMMAND="${DISABLE_FEEDBACK_COMMAND:-1}"
  export DISABLE_BUG_COMMAND="${DISABLE_BUG_COMMAND:-1}"
  export DISABLE_GROWTHBOOK="${DISABLE_GROWTHBOOK:-1}"
  export DISABLE_AUTOUPDATER="${DISABLE_AUTOUPDATER:-1}"
  export DISABLE_UPDATES="${DISABLE_UPDATES:-1}"
  export DISABLE_UPGRADE_COMMAND="${DISABLE_UPGRADE_COMMAND:-1}"
  export DISABLE_LOGIN_COMMAND="${DISABLE_LOGIN_COMMAND:-1}"
  export DISABLE_LOGOUT_COMMAND="${DISABLE_LOGOUT_COMMAND:-1}"
  export DISABLE_INSTALLATION_CHECKS="${DISABLE_INSTALLATION_CHECKS:-1}"
  export DISABLE_INSTALL_GITHUB_APP_COMMAND="${DISABLE_INSTALL_GITHUB_APP_COMMAND:-1}"
  export DISABLE_EXTRA_USAGE_COMMAND="${DISABLE_EXTRA_USAGE_COMMAND:-1}"
  export ENABLE_CLAUDEAI_MCP_SERVERS="${ENABLE_CLAUDEAI_MCP_SERVERS:-false}"
  export FORCE_AUTOUPDATE_PLUGINS="${FORCE_AUTOUPDATE_PLUGINS:-0}"
  export OTEL_LOG_USER_PROMPTS="${OTEL_LOG_USER_PROMPTS:-0}"
  export OTEL_LOG_RAW_API_BODIES="${OTEL_LOG_RAW_API_BODIES:-0}"
  export OTEL_LOG_TOOL_CONTENT="${OTEL_LOG_TOOL_CONTENT:-0}"
  export OTEL_LOG_TOOL_DETAILS="${OTEL_LOG_TOOL_DETAILS:-0}"
  export OTEL_METRICS_EXPORTER="${OTEL_METRICS_EXPORTER:-none}"
  export OTEL_LOGS_EXPORTER="${OTEL_LOGS_EXPORTER:-none}"
  export OTEL_TRACES_EXPORTER="${OTEL_TRACES_EXPORTER:-none}"
  # Unset OTLP protocol env vars to prevent claude-code v1.0.58 from crashing
  # when the host environment (e.g. GitHub Actions runner) sets them to unknown values.
  # claude-code parses OTEL_EXPORTER_OTLP_PROTOCOL when OTEL_METRICS_EXPORTER=otlp
  # and throws on unrecognized values like "none".
  unset OTEL_EXPORTER_OTLP_PROTOCOL OTEL_EXPORTER_OTLP_METRICS_PROTOCOL OTEL_EXPORTER_OTLP_LOGS_PROTOCOL 2>/dev/null || true
  export npm_config_update_notifier="${npm_config_update_notifier:-false}"
  export NO_UPDATE_NOTIFIER="${NO_UPDATE_NOTIFIER:-1}"
  export NPM_CONFIG_AUDIT="${NPM_CONFIG_AUDIT:-false}"
  export NPM_CONFIG_FUND="${NPM_CONFIG_FUND:-false}"
fi

# ── Defaults ─────────────────────────────────────────────────────────
: "${JEANCLAUDE_MODE:=direct}"
: "${JEANCLAUDE_MODEL_PROFILE:=v4-pro-thinking}"
: "${JEANCLAUDE_ANTHROPIC_BASE_URL:=https://api.deepseek.com/anthropic}"
: "${JEANCLAUDE_OPEN_RESPONSES_URL:=http://open-responses:8080}"
: "${JEANCLAUDE_OPEN_RESPONSES_PUBLIC_URL:=http://127.0.0.1:8080}"
: "${JEANCLAUDE_WORKDIR:=/workspace}"

# ── Ephemeral home in privacy lockdown ──────────────────────────────
if is_truthy "${JEANCLAUDE_PRIVACY_LOCKDOWN:-1}" && is_truthy "${JEANCLAUDE_EPHEMERAL_HOME:-1}"; then
  EPHEMERAL_HOME="${JEANCLAUDE_TMP:-/tmp}/jeanclaude-ephemeral-$$-$(date +%s)"
  mkdir -p "$EPHEMERAL_HOME"
  export HOME="$EPHEMERAL_HOME"
  export CLAUDE_CONFIG_DIR="${EPHEMERAL_HOME}/.config/claude"
  export XDG_CONFIG_HOME="${EPHEMERAL_HOME}/.config"
  export XDG_STATE_HOME="${EPHEMERAL_HOME}/.local/state"
  export XDG_CACHE_HOME="${EPHEMERAL_HOME}/.cache"
  mkdir -p "$CLAUDE_CONFIG_DIR" "$XDG_STATE_HOME" "$XDG_CACHE_HOME"
  export JEANCLAUDE_CLAUDE_HOME="$CLAUDE_CONFIG_DIR"
  export _JEANCLAUDE_EPHEMERAL_HOME="$EPHEMERAL_HOME"

  # Cleanup on exit
  cleanup_ephemeral() {
    rm -rf "$EPHEMERAL_HOME" 2>/dev/null || true
  }
  trap cleanup_ephemeral EXIT
fi

: "${JEANCLAUDE_CLAUDE_HOME:=/home/jeanclaude/.claude}"
: "${JEANCLAUDE_WEB_SEARCH:=off}"
: "${JEANCLAUDE_DOCUMENTS:=off}"
: "${JEANCLAUDE_DOCUMENT_STORE:=${JEANCLAUDE_WORKDIR}/.jeanclaude/documents}"
: "${JEANCLAUDE_OPEN_RESPONSES_READY_TIMEOUT:=45}"
: "${JEANCLAUDE_GATEWAY_MODE:=auto}"
: "${JEANCLAUDE_GATEWAY_HOST:=127.0.0.1}"
: "${JEANCLAUDE_GATEWAY_PORT:=auto}"
: "${JEANCLAUDE_GATEWAY_URL:=}"
: "${JEANCLAUDE_GATEWAY_KEEPALIVE:=0}"
: "${JEANCLAUDE_GATEWAY_LOG_LEVEL:=error}"

mkdir -p "$JEANCLAUDE_WORKDIR"

export JEANCLAUDE_GATEWAY_MODE JEANCLAUDE_GATEWAY_HOST JEANCLAUDE_GATEWAY_PORT
export JEANCLAUDE_GATEWAY_URL JEANCLAUDE_GATEWAY_KEEPALIVE JEANCLAUDE_GATEWAY_LOG_LEVEL

# ── Delegate to standalone wrapper ────────────────────────────────────
STANDALONE=""
if [[ -x /opt/jeanclaude/bin/jeanclaude-standalone.js ]] && command -v node >/dev/null 2>&1; then
  STANDALONE="/opt/jeanclaude/bin/jeanclaude-standalone.js"
elif [[ -x /usr/local/bin/jeanclaude-standalone ]]; then
  exec /usr/local/bin/jeanclaude-standalone "$@"
else
  die "standalone wrapper not found"
fi

exec node "$STANDALONE" "$@"
